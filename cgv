#!/usr/bin/env bash
# 가상환경을 알아서 켜고 명령을 실행한다.
#   ./cgv check --notify
#   ./cgv login
#   ./cgv watch
# `source .venv/bin/activate` 를 매번 기억할 필요가 없다.
set -u
cd "$(dirname "$0")"

if [ -d .venv ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
elif [ ! -f requirements.txt ]; then
  echo "cgv 프로젝트 폴더 안에서 실행하세요." >&2
  exit 1
else
  echo "⚠️  .venv 가 없습니다. 먼저 설치하세요:  bash setup.sh" >&2
  exit 1
fi

PY="$(command -v python || command -v python3)"
if [ -z "$PY" ]; then
  echo "❌ 파이썬을 찾지 못했습니다. bash setup.sh 를 다시 실행하세요." >&2
  exit 1
fi

# 감시는 맥이 잠들면 멈추므로 caffeinate 로 감싼다.
if [ "${1:-}" = "watch" ] && [ "$(uname)" = "Darwin" ] && command -v caffeinate >/dev/null; then
  echo "☕ 잠자기 방지(caffeinate)를 켠 채로 감시합니다. 덮개는 열어두세요."
  exec caffeinate -i "$PY" -m cgv_watch "$@"
fi

exec "$PY" -m cgv_watch "$@"
